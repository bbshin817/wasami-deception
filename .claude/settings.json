{
  "permissions": {
    "allow": [
      "Bash(python Tools/editor_cycle.py *)",
      "PowerShell(python Tools/editor_cycle.py *)",
      "Bash(python Tools/overnight.py --dry-run *)",
      "PowerShell(python Tools/overnight.py --dry-run *)",
      "Bash(\"C:/Program Files/Epic Games/UE_5.8/Engine/Build/BatchFiles/RunUAT.bat\" BuildCookRun *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/post_edit_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/stop_hook.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/session_start_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
