# =========================================================
# Unreal Engine (C++) プロジェクト用 .gitignore
# =========================================================

# ---- UE が自動生成するフォルダ (ビルド成果物・キャッシュ・ログ等) ----
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# プラグイン配下の生成物
/Plugins/**/Binaries/
/Plugins/**/Intermediate/

# ---- ビルド済みライティングデータ (Build Lighting で再生成可能) ----
*_BuiltData.uasset

# ---- パッケージ出力 ----
# Build/ はアイコンと PakBlacklist のみ追跡する
/Build/*
!/Build/*/
/Build/*/**
!/Build/*/PakBlacklist*.txt
!/Build/**/*.ico

# ---- IDE プロジェクトファイル ("Generate Project Files" で再生成可能) ----
# Visual Studio
.vs/
*.sln
*.slnx
*.suo
*.user
*.VC.db
*.VC.opendb
.vsconfig
# JetBrains Rider
.idea/
# Visual Studio Code
.vscode/
*.code-workspace
# Xcode
*.xcodeproj
*.xcworkspace

# ---- 参照データ（本家とファンゲームの書き出し、計約 29 GB。git の対象外） ----
/pak_reference/
/pak_reference_2/
/cc2_reference/

# ---- 参照データからスクリプトで作り直せる素材（Tools/ と Content/Python/wasami_tools が作る） ----
/Content/DD/
/Content/Pipeline/
/Content/Stage/
/Content/Developers/
/Content/Collections/

# ---- Python のキャッシュ ----
__pycache__/

# ---- Claude Code の個人設定 ----
.claude/settings.local.json

# ---- OS が生成するファイル ----
Thumbs.db
Desktop.ini
.DS_Store

# 検証用ファイル等を配置するディレクトリ
tmp
# 本家の実機を観察して撮った画面（原作の素材なので git には入れない。撮り直せる）
# 測った値をまとめた README だけは追う（本作の判断の根拠になるので）
/observations/*
!/observations/README.md
